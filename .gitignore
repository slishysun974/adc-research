/.Xil/
/xsim.dir/
/vivado*.jou
/vivado*.log
/xelab.log
/xelab.pb
/xvlog.log
/xvlog.pb
/xsim*.jou
/xsim*.log

# Presentation preview service state; retain sources and reviewed deliverables.
/output/**/live_preview/
